{
  "name": "japanese",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "japanese",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Optional: keep until one-time KV→D1 import runs on first API request, then remove.
  "kv_namespaces": [
    {
      "binding": "APP_STATE"
    }
  ]
}
