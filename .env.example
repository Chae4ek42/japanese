# Optional OpenAI-compatible LLM for «Контекст» (i+N sentence fallback).
# Copy to `.env` and fill the key. Never commit real keys.

VITE_CONTEXT_LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
VITE_CONTEXT_LLM_API_KEY=
# Recommended free model (handles Japanese + JSON well):
VITE_CONTEXT_LLM_MODEL=openai/gpt-oss-20b:free
# Alternatives (availability rotates):
# VITE_CONTEXT_LLM_MODEL=google/gemma-4-31b-it:free
# VITE_CONTEXT_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Avoid openrouter/free for this app — it often routes to reasoning models that break JSON/JP.
